# Copy to .env for local development. Never commit .env.
# In production every value lives in AWS SSM Parameter Store under /si/production/<NAME>
# and deploy/deploy.sh renders them into /opt/si/.env on the instance.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
# Comma-separated browser origins allowed for HTTP and websocket calls.
CORS_ORIGINS=http://localhost:4200
# Public hostname Caddy serves in production (unused locally).
API_DOMAIN=api.startnowapp.com

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=si-core
# Local development only: let Sequelize alter tables to match the models.
# Production ignores this flag and relies on database/migrations.
DB_SYNC=true

# Auth
JWT_SECRET=local-dev-only-change-me
GOOGLE_CLIENT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4200/auth/login

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Email (AWS SES SMTP)
SMTP_HOST=email-smtp.us-west-1.amazonaws.com
SMTP_PORT=465
EMAIL_SECURE=true
SMTP_REGION=us-west-1
SMTP_USER_NAME=
SMTP_PASSWORD=

# Avatars bucket. Leave the three key fields empty on the EC2 instance:
# the instance role is used instead.
AWS_REGION=us-west-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
